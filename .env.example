# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# Default admin (used only on first DB init)
ADMIN_USERNAME=root
ADMIN_PASSWORD=toor
ADMIN_EMAIL=admin@localhost

# SMTP (leave blank to log emails to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@upcoming-conferences.local

# Public base URL (used in notification emails)
APP_BASE_URL=http://localhost:3000
